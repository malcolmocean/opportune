ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
NODE_URL=http://localhost:3400
PORT=3400
DB_PATH=./data/opportune.db
JUDGE_MODEL=claude-opus-5-5
AGENT_MODEL=claude-opus-5-5
FIREBASE_SERVICE_ACCOUNT_JSON=
# channels/email: magic-link sign-in and nudges by mail, sent through Resend (resend.com). Unset → email sign-in off.
RESEND_API_KEY=
EMAIL_FROM=opportune <hello@mail.opportune.club>
# Android App Links: SHA-256 of the APK signing cert(s), comma-separated (keytool -list -v -keystore ~/.android/debug.keystore -storepass android)
ANDROID_CERT_SHA256=
OPJACK_URL=
OPJACK_TOKEN=
ADMIN_TOKEN=
# sources/mapsSharing: python interpreter used to run the Google Maps location-sharing fetch script (default: python3)
MAPS_SHARING_PYTHON=
# sources/tweets: URL + bearer key of the tweet archive service the node polls for mentions
TWEETS_ARCHIVE_URL=
TWEETS_ARCHIVE_KEY=
# set to any value to also print debug-level log lines
DEBUG=
COMMENT_TOKEN=commentplz   # shared word gating comments on site/onboarding.html
