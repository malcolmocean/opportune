<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg" />

    <!-- Shown only when the node can't be reached -->
    <LinearLayout
        android:id="@+id/fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="@color/bg"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/fg"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/fallbackMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/fg_muted"
            android:textSize="15sp"
            android:gravity="center" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="@string/retry" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/change_node"
            android:textColor="@color/fg_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/nodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/node_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/fg"
            android:textColorHint="@color/fg_muted"
            android:textSize="14sp"
            android:importantForAutofill="no" />
    </LinearLayout>
</FrameLayout>
