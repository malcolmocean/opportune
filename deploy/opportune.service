[Unit]
Description=opportune node
After=network-online.target
Wants=network-online.target

[Service]
User=opportune
WorkingDirectory=/opt/opportune
EnvironmentFile=/opt/opportune/.env
Environment=PORT=3400
Environment=MAPS_SHARING_PYTHON=/opt/opportune/sources/mapsSharing/.venv/bin/python
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
